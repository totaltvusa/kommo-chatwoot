    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst caracasOffset = -4 * 60;\nconst localNow = new Date(now.getTime() + (now.getTimezoneOffset() + caracasOffset) * 60000);\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst todayStr = `${localNow.getFullYear()}-${pad(localNow.getMonth() + 1)}-${pad(localNow.getDate())}`;\n\nconst localPlus4 = new Date(localNow.getTime() + 4 * 24 * 60 * 60000);\nconst todayPlus4Str = `${localPlus4.getFullYear()}-${pad(localPlus4.getMonth() + 1)}-${pad(localPlus4.getDate())}`;\n\nconst getField = (obj, regex) => {\n  if (!obj) return '';\n  for (const k of Object.keys(obj)) {\n    if (regex.test(k)) {\n      const v = obj[k];\n      if (v !== undefined && v !== null) return v;\n    }\n  }\n  return '';\n};\n\nconst normalizeDate = (val) => {\n  if (!val) return '';\n  const str = String(val).trim();\n  const raw = str.split(' ')[0].split('T')[0];\n  const p = raw.split(/[\\/\\-]/);\n  if (p.length === 3) {\n    if (p[0].length === 4) {\n      return `${p[0]}-${pad(p[1])}-${pad(p[2])}`;\n    } else if (p[2].length === 4 || p[2].length === 2) {\n      const yr = p[2].length === 2 ? '20' + p[2] : p[2];\n      let day = p[0];\n      let month = p[1];\n      if (parseInt(month, 10) > 12 && parseInt(day, 10) <= 12) {\n        day = p[1];\n        month = p[0];\n      }\n      return `${yr}-${pad(month)}-${pad(day)}`;\n    }\n  }\n  return raw;\n};\n\nconst formatSpanishDate = (isoStr) => {\n  if (!isoStr) return '';\n  const parts = String(isoStr).trim().split(' ')[0].split('T')[0].split(/[\\/\\-]/);\n  const months = [\n    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',\n    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'\n  ];\n  if (parts.length === 3) {\n    if (parts[0].length === 4) {\n      const day = parseInt(parts[2], 10);\n      const monthIdx = parseInt(parts[1], 10) - 1;\n      if (monthIdx >= 0 && monthIdx < 12 && !isNaN(day)) {\n        return `${day} de ${months[monthIdx]}`;\n      }\n    } else {\n      let day = parseInt(parts[0], 10);\n      let monthIdx = parseInt(parts[1], 10) - 1;\n      if (monthIdx >= 12 && day <= 12) {\n        monthIdx = parseInt(parts[0], 10) - 1;\n        day = parseInt(parts[1], 10);\n      }\n      if (monthIdx >= 0 && monthIdx < 12 && !isNaN(day)) {\n        return `${day} de ${months[monthIdx]}`;\n      }\n    }\n  }\n  return isoStr;\n};\n\nconst results = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n  const rawVence = getField(row, /^vence/i);\n  const venceIso = normalizeDate(rawVence);\n  const venceFormatted = formatSpanishDate(venceIso);\n  const play = String(getField(row, /^play/i)).trim().toUpperCase();\n  const usuario = String(getField(row, /^usuario/i)).trim();\n  const nombre = String(getField(row, /^nombre/i) || 'Cliente').trim();\n  const apellido = String(getField(row, /^apellido/i)).trim();\n  const telefono = String(getField(row, /^tel|phone/i)).replace(/\\D/g, '');\n  const rowNum = row.row_number ? parseInt(row.row_number, 10) : (i + 2);\n\n  if (!usuario && !telefono && !nombre) continue;\n\n  // Teléfono de USA: comienza por 1 y tiene longitud de teléfono válida (mínimo 10 u 11 dígitos)\n  const isUSA = telefono.startsWith('1') && telefono.length >= 10;\n\n  if (venceIso && venceIso === todayStr && play !== 'SENT' && play !== 'EMAIL' && (usuario || telefono)) {\n    results.push({\n      json: {\n        ...row,\n        row_number: rowNum,\n        Nombre: nombre,\n        Apellido: apellido,\n        Teléfono: telefono,\n        Telefono: telefono,\n        Usuario: usuario,\n        Vence: venceIso,\n        vence_formatted: venceFormatted,\n        PLAY: play,\n        is_usa: isUSA,\n        category: isUSA ? 'vence_hoy_usa' : 'vence_hoy_no_usa'\n      }\n    });\n  } else if (venceIso && venceIso === todayPlus4Str && play !== 'SENT4' && play !== 'EMAIL4' && play !== 'SENT' && play !== 'EMAIL' && (usuario || telefono)) {\n    results.push({\n      json: {\n        ...row,\n        row_number: rowNum,\n        Nombre: nombre,\n        Apellido: apellido,\n        Teléfono: telefono,\n        Telefono: telefono,\n        Usuario: usuario,\n        Vence: venceIso,\n        vence_formatted: venceFormatted,\n        PLAY: play,\n        is_usa: isUSA,\n        category: isUSA ? 'vence_4dias_usa' : 'vence_4dias_no_usa'\n      }\n    });\n  } else if (venceIso && venceIso < todayStr && (usuario || telefono)) {\n    results.push({\n      json: {\n        ...row,\n        row_number: rowNum,\n        Nombre: nombre,\n        Apellido: apellido,\n        Teléfono: telefono,\n        Telefono: telefono,\n        Usuario: usuario,\n        Vence: venceIso,\n        vence_formatted: venceFormatted,\n        PLAY: play,\n        category: 'vencidos_pasados'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
