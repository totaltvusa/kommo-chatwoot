        "jsCode": "const humanData = $('Agregar etiqueta human').first().json || {};\nreturn [{\n  json: {\n    status: \"success\",\n    human_transfer: \"completed\",\n    conversation_id: humanData.conversation_id,\n    contact_name: humanData.contact_name,\n    message: \"La conversación ha sido transferida exitosamente a un asesor humano.\",\n    instructions_for_ai: \"Informa de inmediato al cliente que la transferencia a soporte humano ha sido realizada exitosamente y que pronto será atendido dentro del horario extendido de oficina de los agentes humanos.\"\n  }\n}];",
