    {
      "id": "d37b0ab8-9efd-4fdb-aaa5-27dd672801fb",
      "name": "Agregar etiqueta human",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "jsCode": "const convData = $('Obtener datos conversacion').first().json || {};\nconst triggerData = $('Preparar Datos Transferencia').first().json || {};\n\nconst conversation_id = triggerData.conversation_id || convData.id || 13;\nconst account_id = triggerData.account_id || convData.account_id || 1;\nconst contact_name = convData.meta?.sender?.name || 'Cliente';\n\n// Safely preserve all current labels\nlet currentLabels = Array.isArray(convData.labels) ? [...convData.labels] : [];\n\nif (!currentLabels.includes('human')) {\n  currentLabels.push('human');\n}\n\nreturn [{\n  json: {\n    conversation_id,\n    account_id,\n    contact_name,\n    labels: currentLabels\n  }\n}];",
        "mode": "runOnceForAllItems"
      }
    },
