    {
      "parameters": {
        "jsCode": "const convData = $('Obtener datos conversacion').first().json || {};\nconst triggerData = $('Execute Workflow Trigger').first().json || {};\n\nconst conversation_id = triggerData.conversation_id || convData.id;\nconst account_id = triggerData.account_id || convData.account_id || 1;\nconst contact_name = convData.meta?.sender?.name || 'Desconocido';\n\n// Safely preserve all current labels\nlet currentLabels = Array.isArray(convData.labels) ? [...convData.labels] : [];\n\nif (!currentLabels.includes('human')) {\n  currentLabels.push('human');\n}\n\nreturn {\n  json: {\n    conversation_id,\n    account_id,\n    contact_name,\n    labels: currentLabels\n  }\n};"
      },
