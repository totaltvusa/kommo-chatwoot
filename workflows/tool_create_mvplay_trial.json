      "id": "ff39a236-ed1b-4fc2-9496-aaf8e5eabbb2",
      "name": "Procesar Respuesta MVPlay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json || {};\nconst evalData = $('Evaluar Historial Trials').item.json;\n\nconst isSuccess = resp.status === 'STATUS_SUCCESS';\nconst lineData = resp.data || {};\n\nconst custom_attributes = { ...(evalData.custom_attributes || {}) };\nconst nowIso = new Date().toISOString();\n\nif (evalData.trial_number === 1) {\n  custom_attributes.tvtotal_trial_1_id = lineData.id || 1;\n  custom_attributes.tvtotal_trial_1_username = evalData.username;\n  custom_attributes.tvtotal_trial_1_password = evalData.password;\n  custom_attributes.tvtotal_trial_1_created_at = nowIso;\n} else {\n  custom_attributes.tvtotal_trial_2_id = lineData.id || 2;\n  custom_attributes.tvtotal_trial_2_username = evalData.username;\n  custom_attributes.tvtotal_trial_2_password = evalData.password;\n  custom_attributes.tvtotal_trial_2_created_at = nowIso;\n}\n\nreturn [{\n  json: {\n    is_success: isSuccess,\n    line_id: lineData.id,\n    trial_number: evalData.trial_number,\n    username: evalData.username,\n    password: evalData.password,\n    account_id: evalData.account_id,\n    conversation_id: evalData.conversation_id,\n    contact_id: evalData.contact_id,\n    custom_attributes\n  }\n}];"
      }
