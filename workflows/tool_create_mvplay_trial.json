    {
      "id": "c9f5f11e-59ec-4e08-8cd6-31aae98a9c5a",
      "name": "Evaluar Historial Trials",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const convData = $input.first().json || {};\nconst contact = convData.meta?.sender || convData.sender || {};\nconst customAttr = contact.custom_attributes || {};\n\nconst trial1 = customAttr.tvtotal_trial_1_id || customAttr.trial_1_id;\nconst trial2 = customAttr.tvtotal_trial_2_id || customAttr.trial_2_id;\n\nlet trial_number = 1;\nlet can_create = true;\n\nif (!trial1) {\n  trial_number = 1;\n} else if (!trial2) {\n  trial_number = 2;\n} else {\n  can_create = false;\n  trial_number = 3;\n}\n\nconst genNode = $('Generar Credenciales').item.json;\n\nreturn [{\n  json: {\n    can_create,\n    trial_number,\n    contact_id: contact.id,\n    custom_attributes: customAttr,\n    username: genNode.username,\n    password: genNode.password,\n    note: genNode.note,\n    account_id: genNode.account_id,\n    conversation_id: genNode.conversation_id,\n    contact_name: genNode.contact_name,\n    phone: genNode.phone,\n    email: genNode.email\n  }\n}];"
      }
    },
