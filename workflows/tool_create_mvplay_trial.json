      "id": "7f1ff22f-e12a-4e2e-887c-45bccce0ed5c",
      "name": "Generar Credenciales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json || {};\nconst contact_name = item.contact_name || item.name || 'Cliente';\nconst email = item.email || '';\nconst raw_phone = (item.phone || '').toString();\nconst clean_phone = raw_phone.replace(/\\D/g, '');\n\nconst account_id = item.account_id || 1;\nconst conversation_id = item.conversation_id;\n\nlet phone_digits = clean_phone.slice(-7);\nif (!phone_digits || phone_digits.length < 5) {\n  phone_digits = Math.floor(1000000 + Math.random() * 9000000).toString();\n}\nconst username = 'ttv' + phone_digits;\nconst password = Math.floor(100000 + Math.random() * 900000).toString();\nconst note = `${contact_name} | ${clean_phone || 'Sin Tel'} | ${email || 'Sin Email'}`;\n\nreturn [{\n  json: {\n    contact_name,\n    email,\n    phone: clean_phone,\n    username,\n    password,\n    note,\n    account_id,\n    conversation_id\n  }\n}];"
      }
    },
