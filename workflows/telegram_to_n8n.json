        "text": "={{\n(() => {\n  const link = $json.data?.urls?.payment_page || $json.checkout_url || $json.paylink;\n  const baseAmt = $('Parsear y Calcular Comando').item.json.baseAmount;\n  const perc = $('Parsear y Calcular Comando').item.json.percentage;\n  const finalAmt = $('Parsear y Calcular Comando').item.json.amount;\n  const order = $('Parsear y Calcular Comando').item.json.orderid;\n\n  if (link) {\n    return '✅ <b>Link de pago PDCash</b>\\n\\n' +\n      '💵 <b>Monto Base:</b> $' + baseAmt + ' USD\\n' +\n      '📊 <b>Ajuste (%):</b> ' + perc + '%\\n' +\n      '💰 <b>Monto a Cobrar:</b> $' + finalAmt + ' USD\\n' +\n      '🆔 <b>Orden:</b> <code>' + order + '</code>\\n\\n' +\n      '🔗 <b>Enlace de Pago:</b>\\n' + link;\n  } else {\n    return '⚠️ <b>Error al generar Link PDCash</b>\\n\\n' +\n      'El servicio externo de pd.cash reportó un error o no responde en este momento (HTTP 500 / Error de pasarela).\\n\\n' +\n      '💵 <b>Monto a Cobrar:</b> $' + finalAmt + ' USD\\n' +\n      '🆔 <b>Orden:</b> <code>' + order + '</code>\\n\\n' +\n      '👉 <i>Por favor intenta nuevamente en unos minutos o genera el link con otro método (<code>/nowpayments</code> o <code>/card2crypto</code>).</i>';\n  }\n})()\n}}",
