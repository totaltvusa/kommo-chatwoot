    {
      "id": "2730d79e-531c-4fb3-843e-5a64217c5d90",
      "name": "Normalizar y Desduplicar Noticias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        500
      ],
      "parameters": {
        "jsCode": "const rawItems = [];\n\nconst extractRss = (nodeName, defaultSource) => {\n  try {\n    const items = $(nodeName).all();\n    for (const item of items) {\n      const j = item.json || {};\n      const title = String(j.title || j['rss:title'] || '').trim();\n      const link = String(j.link || j.guid || j['rss:link'] || '').trim();\n      const desc = String(j.contentSnippet || j.content || j.description || '').replace(/<[^>]*>?/gm, '').trim();\n      const pubDate = String(j.pubDate || j.isoDate || new Date().toISOString());\n      \n      if (title && link) {\n        rawItems.push({\n          title,\n          description: desc.slice(0, 300),\n          url: link,\n          source: defaultSource,\n          pubDate\n        });\n      }\n    }\n  } catch (e) {}\n};\n\nextractRss('RSS El Pais', 'El País');\nextractRss('RSS El Nacional', 'El Nacional (Venezuela)');\nextractRss('RSS Tal Cual', 'Tal Cual Digital');\nextractRss('RSS Telemundo', 'Telemundo');\nextractRss('RSS NYTimes World', 'NYTimes RSS');\n\ntry {\n  const nyRes = $('API NYTimes TopStories').first()?.json || {};\n  if (Array.isArray(nyRes.results)) {\n    for (const article of nyRes.results) {\n      if (article.title && article.url) {\n        rawItems.push({\n          title: article.title,\n          description: (article.abstract || '').slice(0, 300),\n          url: article.url,\n          source: 'NYTimes API',\n          pubDate: article.published_date || new Date().toISOString()\n        });\n      }\n    }\n  }\n} catch (e) {}\n\ntry {\n  const gnewsRes = $('API GNews TopHeadlines').first()?.json || {};\n  if (Array.isArray(gnewsRes.articles)) {\n    for (const article of gnewsRes.articles) {\n      if (article.title && article.url) {\n        rawItems.push({\n          title: article.title,\n          description: (article.description || '').slice(0, 300),\n          url: article.url,\n          source: article.source?.name || 'GNews API',\n          pubDate: article.publishedAt || new Date().toISOString()\n        });\n      }\n    }\n  }\n} catch (e) {}\n\ntry {\n  const newsApiRes = $('API NewsAPI Technology').first()?.json || {};\n  if (Array.isArray(newsApiRes.articles)) {\n    for (const article of newsApiRes.articles) {\n      if (article.title && article.url) {\n        rawItems.push({\n          title: article.title,\n          description: (article.description || '').slice(0, 300),\n          url: article.url,\n          source: article.source?.name || 'NewsAPI Tech',\n          pubDate: article.publishedAt || new Date().toISOString()\n        });\n      }\n    }\n  }\n} catch (e) {}\n\ntry {\n  const worldNewsRes = $('API WorldNews').first()?.json || {};\n  if (Array.isArray(worldNewsRes.top_news)) {\n    for (const group of worldNewsRes.top_news) {\n      if (Array.isArray(group.news)) {\n        for (const article of group.news) {\n          if (article.title && article.url) {\n            rawItems.push({\n              title: article.title,\n              description: (article.text || article.summary || '').slice(0, 300),\n              url: article.url,\n              source: 'WorldNews API',\n              pubDate: article.publish_date || new Date().toISOString()\n            });\n          }\n        }\n      }\n    }\n  }\n} catch (e) {}\n\nconst seenUrls = new Set();\nconst seenTitles = new Set();\nconst uniqueArticles = [];\n\nconst normalizeTitle = (t) => t.toLowerCase().replace(/[^a-z0-9áéíóúñ]/g, '');\n\nfor (const art of rawItems) {\n  const normUrl = art.url.split('?')[0].toLowerCase();\n  const normT = normalizeTitle(art.title);\n  \n  if (seenUrls.has(normUrl) || seenTitles.has(normT)) {\n    continue;\n  }\n  \n  seenUrls.add(normUrl);\n  seenTitles.add(normT);\n  uniqueArticles.push(art);\n}\n\nlet originChatId = null;\ntry {\n  const tgData = $('Telegram Command Trigger').first()?.json || {};\n  if (tgData.message && tgData.message.chat) {\n    originChatId = String(tgData.message.chat.id);\n  }\n} catch (e) {}\n\nreturn [{\n  json: {\n    total_raw: rawItems.length,\n    total_unique: uniqueArticles.length,\n    origin_chat_id: originChatId,\n    articles: uniqueArticles.slice(0, 60)\n  }\n}];"
      }
    },
    {
      "id": "fed19ace-9b5b-4588-8b14-064ee4cc4fe7",
      "name": "Curar y Redactar Noticias con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "deepSeekApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"temperature\": 0.3,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres un editor en jefe senior y periodista de inteligencia artificial especializado en curación de noticias para el público hispanohablante.\\n\\nTu misión es seleccionar EXACTAMENTE 3 noticias más importantes, relevantes o leídas para CADA UNA de las siguientes 5 categorías:\\n1. 🇻🇪 VENEZUELA\\n2. 🌎 USA Y AMÉRICA LATINA\\n3. 🌐 MUNDO\\n4. 💻 TECNOLOGÍA\\n5. 🎭 ESPECTÁCULO & ENTRETENIMIENTO\\n\\nREGLAS ESTRICTAS DE FORMATO Y ESTILO:\\n- Debes seleccionar exactamente 3 noticias por categoría.\\n- Para cada noticia incluye:\\n  * Título / Titular claro en negrita.\\n  * Breve resumen de EXACTAMENTE 2 LÍNEAS (sin excepciones) que aporte contexto real y hechos clave.\\n  * Enlace directo a la fuente original.\\n\\nFORMATO DE SALIDA (Aplica este formato exacto en Markdown):\\n\\n🇻🇪 *VENEZUELA*\\n1. *[Título Noticia 1]*\\n[Resumen línea 1]\\n[Resumen línea 2]\\n🔗 [Leer noticia en la fuente](URL)\\n\\n2. *[Título Noticia 2]*\\n[Resumen línea 1]\\n[Resumen línea 2]\\n🔗 [Leer noticia en la fuente](URL)\\n\\n3. *[Título Noticia 3]*\\n[Resumen línea 1]\\n[Resumen línea 2]\\n🔗 [Leer noticia en la fuente](URL)\\n\\n🌎 *USA Y AMÉRICA LATINA*\\n... (3 noticias con el mismo formato)\\n\\n🌐 *MUNDO*\\n... (3 noticias con el mismo formato)\\n\\n💻 *TECNOLOGÍA*\\n... (3 noticias con el mismo formato)\\n\\n🎭 *ESPECTÁCULO & ENTRETENIMIENTO*\\n... (3 noticias con el mismo formato)\\n\\nNo incluyas saludos, introducciones ni explicaciones adicionales. Genera únicamente el resumen curado.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analiza y cura el siguiente listado de noticias recolectadas hoy:\\n\\n\" + JSON.stringify($json.articles)\n    }\n  ]\n}",
        "options": {}
      },
      "credentials": {
        "deepSeekApi": {
          "id": "22sfGWS6Ev7XMOfa",
          "name": "DeepSeek account"
        }
      }
    },
    {
      "id": "1a7c8e12-e3ce-405c-894f-43e863376ddb",
      "name": "Formatear Mensajes Finales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        500
