        672,
        -240
      ]
    },
    {
      "parameters": {
        "jsCode": "let triggerMsg = {};\ntry {\n  triggerMsg = $('Webhook').first().json.body || {};\n} catch (e) {\n  try {\n    triggerMsg = $('¿Es mensaje entrante?').first().json.body || {};\n  } catch (e2) {}\n}\n\nconst triggerMsgId = triggerMsg.id;\nconst messagesData = $input.item.json || {};\nconst messages = Array.isArray(messagesData.payload) ? messagesData.payload : (messagesData.messages || []);\n\nconst incomingMessages = messages.filter(m => (m.message_type === 0 || m.message_type === 'incoming') && !m.private);\nif (incomingMessages.length === 0) {\n  return { json: { should_respond: false } };\n}\n\nconst latestMsg = incomingMessages[incomingMessages.length - 1];\n\nif (triggerMsgId && latestMsg.id !== triggerMsgId) {\n  return { json: { should_respond: false } };\n}\n\nlet lastOutgoingIndex = -1;\nfor (let i = messages.length - 1; i >= 0; i--) {\n  if ((messages[i].message_type === 1 || messages[i].message_type === 'outgoing') && !messages[i].private) {\n    lastOutgoingIndex = i;\n    break;\n  }\n}\n\nconst unrespondedIncoming = messages.filter((m, idx) => {\n  const isIncoming = (m.message_type === 0 || m.message_type === 'incoming') && !m.private && m.content && m.content.trim();\n  return idx > lastOutgoingIndex && isIncoming;\n});\n\nif (unrespondedIncoming.length === 0) {\n  return { json: { should_respond: false } };\n}\n\nconst combinedText = unrespondedIncoming.map(m => m.content.trim()).join(' ');\n\nreturn {\n  json: {\n    should_respond: true,\n    combined_message: combinedText,\n    conversation_id: triggerMsg.conversation?.id,\n    account_id: triggerMsg.account?.id || 1,\n    inbox_id: triggerMsg.inbox?.id || triggerMsg.conversation?.inbox_id,\n    inbox_name: triggerMsg.inbox?.name || '',\n    labels: triggerMsg.conversation?.labels || []\n  }\n};"
      },
