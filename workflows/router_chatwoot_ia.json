        1120,
        -240
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst inbox_id = parseInt(item.inbox_id) || 0;\nconst labels = (item.labels || []).map(l => String(l).toLowerCase());\nconst inbox_name = String(item.inbox_name || \"\").toLowerCase();\n\nlet brand = \"totaltvusa\";\n\n// TVTotal24 (Latina): Inbox 10 (Telegram) or Latina funnel label / name\nif (\n  inbox_id === 10 ||\n  labels.includes(\"funnel-totaltv-latina\") ||\n  labels.includes(\"funnel-total-tv-latina\") ||\n  inbox_name.includes(\"tvtotal24\") ||\n  inbox_name.includes(\"lat\")\n) {\n  brand = \"tvtotal24\";\n} else {\n  // TotalTv USA: Inboxes 4 (WhatsApp), 6 (Telegram), 7 (Telegram), etc.\n  brand = \"totaltvusa\";\n}\n\nreturn {\n  json: {\n    brand,\n    conversation_id: item.conversation_id,\n    account_id: item.account_id,\n    inbox_id: item.inbox_id,\n    inbox_name: item.inbox_name,\n    message: item.combined_message\n  }\n};"
      },
