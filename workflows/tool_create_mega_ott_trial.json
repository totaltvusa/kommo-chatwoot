    {
      "id": "eef5a7e1-2938-4bd0-8705-ac9290b01353",
      "name": "Evaluar Historial de Trials",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res = $('Obtener Datos Conversación Chatwoot').item.json;\nconst sender = res.meta?.sender || (res.payload && res.payload[0] ? res.payload[0].meta?.sender : {}) || {};\nconst contact_id = sender.id || \"\";\nconst attrs = sender.custom_attributes || {};\n\nconst trial_count = parseInt(attrs.trial_count) || 0;\nconst trial_1_id = attrs.trial_1_id || null;\nconst trial_1_username = attrs.trial_1_username || \"\";\nconst trial_2_id = attrs.trial_2_id || null;\nconst trial_2_username = attrs.trial_2_username || \"\";\n\nlet action = \"create\";\nlet trial_number = 1;\n\nif (trial_count === 1) {\n  if (trial_1_id) {\n    action = \"check_first_trial\";\n    trial_number = 2;\n  } else {\n    action = \"create\";\n    trial_number = 2;\n  }\n} else if (trial_count >= 2) {\n  action = \"limit_reached\";\n}\n\nreturn {\n  json: {\n    action,\n    trial_number,\n    contact_id,\n    trial_1_id,\n    trial_1_username,\n    trial_2_id,\n    trial_2_username\n  }\n};"
      }
    },
