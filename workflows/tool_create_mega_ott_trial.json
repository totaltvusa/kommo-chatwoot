      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const trial_number = $('Evaluar Historial de Trials').item.json.trial_number;\nconst contact_id = $('Evaluar Historial de Trials').item.json.contact_id;\nconst subscription = $input.item.json;\n\nconst custom_attributes = {\n  trial_count: String(trial_number)\n};\ncustom_attributes[`trial_${trial_number}_id`] = String(subscription.id);\ncustom_attributes[`trial_${trial_number}_username`] = subscription.username;\n\nreturn {\n  json: {\n    contact_id,\n    body: {\n      custom_attributes\n    },\n    username: subscription.username,\n    password: subscription.password,\n    dns_link: subscription.dns_link,\n    dns_link_for_samsung_lg: subscription.dns_link_for_samsung_lg,\n    id: subscription.id\n  }\n};"
