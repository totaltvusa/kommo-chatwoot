    {
      "id": "6379f44d-f8a2-478f-b889-2da80ec915a7",
      "name": "Check Status Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.item.json;\nif (item.error || !item.id) {\n  let error_message = \"Error con el teléfono.\";\n  if (item.error && item.error.message) {\n    error_message = item.error.message;\n    try {\n      const jsonPart = error_message.substring(error_message.indexOf('{'));\n      const parsed = JSON.parse(jsonPart);\n      if (parsed.message) error_message = parsed.message;\n    } catch(e) {}\n  }\n  return {\n    json: {\n      success: false,\n      error_message: String(error_message).replace(/[\"\\\\]/g, \"\")\n    }\n  };\n} else {\n  return {\n    json: {\n      success: true,\n      id: item.id,\n      username: item.username,\n      password: item.password,\n      dns_link: item.dns_link,\n      dns_link_for_samsung_lg: item.dns_link_for_samsung_lg\n    }\n  };\n}"
