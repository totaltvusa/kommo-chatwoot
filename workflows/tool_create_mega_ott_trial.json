    {
      "id": "9727dd3d-4785-4861-b9dd-0c4f23ddc9d4",
      "name": "Generar Credenciales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const trigger = $input.item.json;\nlet contact_name = \"Cliente\";\nlet email = \"\";\nlet phone = \"\";\n\nif (trigger.query) {\n  try {\n    const parsed = JSON.parse(trigger.query);\n    contact_name = parsed.contact_name || contact_name;\n    email = parsed.email || email;\n    phone = parsed.phone || phone;\n  } catch (e) {\n    // Ignore parse error\n  }\n}\n\ncontact_name = trigger.contact_name || contact_name;\nemail = trigger.email || email;\nphone = trigger.phone || phone;\n\nconst conversation_id = trigger.conversation_id || \"\";\nconst account_id = trigger.account_id || \"\";\n\nconst randomStr = Math.random().toString(36).substring(2, 8).toUpperCase();\nconst auto_username = \"TTV\" + randomStr;\nconst auto_password = Math.random().toString(36).substring(2, 8).toUpperCase();\n\nreturn {\n  json: {\n    conversation_id,\n    account_id,\n    contact_name: String(contact_name).trim(),\n    email: String(email).trim().toLowerCase(),\n    phone: String(phone).replace(/\\D/g, \"\"),\n    auto_username,\n    auto_password,\n    note: String(contact_name).trim()\n  }\n};"
      }
    },
